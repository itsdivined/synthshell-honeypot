# Copy this file to .env and fill in the values there.
# .env is gitignored. Do not put a real key in this file.

# Lab listener. The code refuses any address other than 127.0.0.1.
HONEYPOT_BIND=127.0.0.1

# Cowrie baseline. Use the account from Cowrie's own local userdb.
# Leave these empty until Cowrie is installed. The replay records a skip.
COWRIE_HOST=127.0.0.1
COWRIE_PORT=2222
COWRIE_USER=
COWRIE_PASSWORD=

# GPT-4o mini. Leave the key empty to record a skip. The study still includes this model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local models. The study includes both. If Ollama is not running, the replay records a skip.
OLLAMA_HOST=127.0.0.1:11434
LLAMA_MODEL=llama3.1:8b
QWEN_MODEL=qwen2.5:7b

# Optional USD per million tokens for GPT-4o mini. Leave blank until you copy the provider's current price.
GPT4O_MINI_INPUT_PER_MILLION=
GPT4O_MINI_OUTPUT_PER_MILLION=
